---
import { site } from '../data/site';
const { current = '' } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Samuel Extehines Heydemans — Home">
      <img src="/images/brand.svg" width="37" height="48" alt="" />
    </a>
    <nav class="header-links" aria-label="Main navigation">
      <a href={site.links.behance} target="_blank" rel="noopener noreferrer">
        Behance<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a href={site.links.theHouseWorks} target="_blank" rel="noopener noreferrer">
        The House Works<span class="sr-only"> (opens in a new tab)</span>
      </a>
    </nav>
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <svg
        class="menu-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="menu-line menu-line-top" d="M4 7H20" />
        <path class="menu-line menu-line-middle" d="M4 12H20" />
        <path class="menu-line menu-line-bottom" d="M4 17H20" />
      </svg>
    </button>
  </div>
  <nav id="mobile-navigation" class="mobile-navigation" aria-label="Mobile navigation" inert>
    <a href="/#hero">Home</a>
    <a href={site.links.behance} target="_blank" rel="noopener noreferrer">
      Behance ↗<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href={site.links.theHouseWorks} target="_blank" rel="noopener noreferrer">
      The House Works ↗<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </nav>
</header>
<noscript>
  <nav class="no-script-nav" aria-label="Additional navigation">
    <a href={site.links.behance}>Behance</a>
    <a href={site.links.linkedin}>LinkedIn</a>
  </nav>
</noscript>
